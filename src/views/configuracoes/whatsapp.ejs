<%- include('../partials/inicio', { titulo: 'Configurações · WhatsApp' }) %>
<%- include('../partials/nav', { atendenteLogado }) %>
<%
  const AVISOS = {
    conexao: 'Escolha salva. Ela vale depois de reiniciar o sistema (no servidor: systemctl restart).',
    numero: 'Número adicionado. Leia o QR Code dele com o WhatsApp do celular desse número.',
    'numero-reiniciar': 'Número adicionado. Ele liga quando o sistema for reiniciado (aqui é um painel de teste).',
    salvo: 'Número salvo.',
    testado: 'Dados da Meta salvos e conferidos: a conexão com a API oficial funcionou.',
    falhou: 'Dados salvos, mas a conferência com a Meta falhou. Veja o erro abaixo.',
    codigo: 'Código de verificação trocado. Atualize na Meta (Webhook > Verify token).',
    modelos: 'Modelos atualizados com os da Meta.',
    botoes: 'Escolha dos botões salva. Vale já nas próximas mensagens do bot.',
  };
  const c = config;
  const SITUACAO = { APPROVED: 'Aprovado', PENDING: 'Em análise', REJECTED: 'Recusado', PAUSED: 'Pausado', DISABLED: 'Desativado' };
%>
<main class="conteudo conteudo-estreita pagina-config">
  <p class="trilha-config"><a href="/painel/configuracoes">Configurações</a> › WhatsApp</p>
  <h1>WhatsApp</h1>
  <% if (erro) { %><p class="erro"><%= erro %></p><% } %>
  <% if (aviso && AVISOS[aviso]) { %><p class="<%= aviso === 'falhou' ? 'aviso' : 'sucesso' %>"><%= AVISOS[aviso] %></p><% } %>

  <fieldset>
    <legend>Como o WhatsApp está ligado</legend>
    <form method="post" action="/painel/configuracoes/whatsapp/conexao" class="form-conexao">
      <label class="linha"><input type="radio" name="whatsapp_conexao" value="celular" <%= escolhida === 'celular' ? 'checked' : '' %>>
        <span><strong>WhatsApp do celular (QR Code)</strong><br><span class="dica-inline">Lê o QR Code com o WhatsApp do número. Sem custo por mensagem, mas não é oficial: mandar muito pode bloquear o número.</span></span></label>
      <label class="linha"><input type="radio" name="whatsapp_conexao" value="oficial" <%= escolhida === 'oficial' ? 'checked' : '' %>>
        <span><strong>API oficial da Meta</strong><br><span class="dica-inline">O jeito oficial para empresas. A Meta cobra por mensagem nas conversas que a empresa começa (lembretes, campanhas). Depois de 24 h sem o cliente escrever, só vai modelo aprovado.</span></span></label>
      <p><button type="submit" class="botao-pequeno">Salvar escolha</button></p>
    </form>
    <p class="dica">Em uso agora: <strong><%= emUso === 'oficial' ? 'API oficial da Meta' : 'WhatsApp do celular' %></strong>.
      <% if (escolhida !== emUso) { %><span class="selo selo-situacao-ignorado">Reinicie o sistema para passar a usar <%= escolhida === 'oficial' ? 'a API oficial' : 'o celular' %>.</span><% } %></p>
  </fieldset>

  <fieldset>
    <legend>Opções do bot como botões</legend>
    <form method="post" action="/painel/configuracoes/whatsapp/botoes">
      <label class="linha"><input type="checkbox" name="botoes_interativos" value="1" <%= botoesInterativos ? 'checked' : '' %>>
        <span>Mostrar as opções numeradas do bot como <strong>botões</strong> (até 3) ou <strong>lista</strong> (até 10)<br>
          <span class="dica-inline">Vale na API oficial e no Instagram (lá viram respostas rápidas). Pelo WhatsApp do celular continua o texto
            numerado. O cliente toca na opção em vez de digitar o número; se a pergunta não der para virar botão, vai o texto.</span></span></label>
      <p><button type="submit" class="botao-pequeno">Salvar</button></p>
    </form>
  </fieldset>

  <% if (emUso === 'celular') { %>
    <h2>Números</h2>
    <p class="dica">Cada número é um WhatsApp ligado pelo QR Code. Todas as conversas caem na mesma Fila, mostrando por qual número
      chegaram, e a resposta sai pelo mesmo número. Cada número usa o <strong>fluxo do bot</strong> escolhido (pode ser o mesmo para todos).</p>
    <% numeros.forEach((n) => { %>
      <fieldset class="cartao-numero<%= n.ativo ? '' : ' cartao-numero-desligado' %>" id="numero-<%= n.id %>">
        <legend><%= n.nome %></legend>
        <% if (!n.ativo) { %>
          <p class="dica">Desligado. As conversas que vieram por ele continuam no histórico.</p>
        <% } else if (n.estado.conectado) { %>
          <p class="sucesso">✅ WhatsApp conectado: recebendo e enviando mensagens.</p>
        <% } else if (n.estado.qr) { %>
          <p class="dica">Abra o WhatsApp <strong>deste número</strong> no celular → <strong>Aparelhos conectados</strong> →
            <strong>Conectar um aparelho</strong> → aponte a câmera para este QR Code. Ele troca sozinho a cada poucos segundos.</p>
          <p class="qr-codigo"><img src="/painel/configuracoes/whatsapp/qr.png?numero=<%= n.id %>" alt="QR Code para conectar <%= n.nome %>" width="280" height="280"></p>
        <% } else { %>
          <p class="erro">⚠️ WhatsApp desconectado e nenhum QR Code disponível ainda. Se o sistema acabou de ligar, espere alguns segundos (a página atualiza sozinha).</p>
        <% } %>
        <form method="post" action="/painel/configuracoes/whatsapp/numeros/<%= n.id %>" class="linha-form linha-form-inline form-numero">
          <label>Nome<input type="text" name="nome" value="<%= n.nome %>" maxlength="40" required></label>
          <label>Fluxo do bot
            <select name="fluxo_id">
              <% fluxos.forEach((f) => { %><option value="<%= f.id %>" <%= (n.fluxo_id || 1) === f.id ? 'selected' : '' %>><%= f.nome %></option><% }) %>
            </select>
          </label>
          <button type="submit" class="botao-pequeno">Salvar</button>
        </form>
        <form method="post" action="/painel/configuracoes/whatsapp/numeros/<%= n.id %>/ativo" onsubmit="return confirm('<%= n.ativo ? 'Desligar este número? Ele para de receber e de mandar mensagens (o celular continua com o WhatsApp normal).' : 'Ligar este número de novo?' %>')">
          <button type="submit" class="botao-link <%= n.ativo ? 'botao-link-perigo' : '' %>"><%= n.ativo ? 'Desligar este número' : 'Ligar este número' %></button>
        </form>
      </fieldset>
    <% }) %>
    <form method="post" action="/painel/configuracoes/whatsapp/numeros" class="linha-form">
      <input type="text" name="nome" maxlength="40" placeholder="Nome do número novo. Ex.: Suporte 2" required aria-label="Nome do número novo">
      <button type="submit">+ Adicionar número</button>
    </form>
    <p class="dica">Os fluxos são criados no menu <a href="/painel/fluxo">Fluxo</a> (Mais ▾ › Fluxos).</p>
  <% } %>

  <% if (escolhida === 'oficial' || emUso === 'oficial') { %>
    <h2>API oficial da Meta</h2>
    <% if (c.testado_em) { %>
      <% if (c.erro) { %><p class="erro">Última conferência falhou: <%= c.erro %></p>
      <% } else { %><p class="sucesso">✅ Conectado à Meta: <strong><%= c.numero_exibicao %></strong> · <%= c.nome_verificado %><% if (c.qualidade) { %> · qualidade <%= c.qualidade === 'GREEN' ? 'boa' : c.qualidade === 'YELLOW' ? 'média' : c.qualidade === 'RED' ? 'baixa' : c.qualidade %><% } %></p><% } %>
    <% } %>
    <form method="post" action="/painel/configuracoes/whatsapp/oficial" autocomplete="off">
      <fieldset>
        <legend>Dados da Meta</legend>
        <p class="dica">Tudo isso aparece no painel de desenvolvedores da Meta, em WhatsApp › Configuração da API (o passo a passo está no documento da E4).</p>
        <label>Código do número (Phone number ID)<input type="text" name="numero_id" value="<%= c.numero_id || '' %>" inputmode="numeric"></label>
        <label>Código da conta (WhatsApp Business Account ID)<input type="text" name="conta_id" value="<%= c.conta_id || '' %>" inputmode="numeric">
          <span class="ajuda">Usado para puxar os modelos aprovados.</span></label>
        <label>Chave de acesso permanente (token)<input type="password" name="chave" value="" placeholder="<%= c.temChave ? `Guardada (${c.chave}). Deixe em branco para manter.` : 'Cole aqui a chave do usuário do sistema' %>">
          <span class="ajuda">Fica guardada só no banco do sistema e nunca aparece inteira de novo.</span></label>
        <label>Segredo do app (App secret)<input type="password" name="segredo_app" value="" placeholder="<%= c.temSegredo ? `Guardado (${c.segredo_app}). Deixe em branco para manter.` : 'Cole aqui o segredo do app' %>">
          <span class="ajuda">Confere que as mensagens que chegam vieram mesmo da Meta.</span></label>
        <label>Versão da API<input type="text" name="versao" value="<%= c.versao %>" class="campo-curto"></label>
        <p><button type="submit">Salvar e conferir com a Meta</button></p>
      </fieldset>
    </form>
    <% if (c.temChave) { %><form method="post" action="/painel/configuracoes/whatsapp/oficial/testar" class="acoes-topo"><button type="submit" class="botao-secundario">Conferir de novo</button></form><% } %>

    <fieldset>
      <legend>Webhook (onde a Meta entrega as mensagens)</legend>
      <p class="dica">Na Meta, em WhatsApp › Configuração › Webhook, cole:</p>
      <label>URL de retorno (Callback URL)<input type="text" readonly value="<%= enderecoWebhook %>" onclick="this.select()"></label>
      <label>Token de verificação (Verify token)<input type="text" readonly value="<%= c.codigo_verificacao %>" onclick="this.select()"></label>
      <p class="dica">E marque o campo <strong>messages</strong> em "Campos do webhook". O endereço precisa ser HTTPS e público (o do servidor, não o do computador).</p>
      <form method="post" action="/painel/configuracoes/whatsapp/oficial/codigo" onsubmit="return confirm('Trocar o token de verificação? Vai ser preciso atualizar na Meta.')"><button type="submit" class="botao-link">Trocar o token de verificação</button></form>
    </fieldset>

    <p class="acoes-topo"><a class="botao" href="/painel/configuracoes/whatsapp/custos">Custos da Meta</a>
      <span class="dica-inline">quantos modelos saíram no mês e quanto a Meta deve cobrar</span></p>

    <h2>Modelos aprovados</h2>
    <p class="dica">Fora das 24 h, a API oficial só manda <strong>modelo</strong> (template) aprovado pela Meta. Os modelos são criados na Meta
      (WhatsApp Manager › Modelos de mensagem); aqui você puxa a lista para usar na conversa, nos lembretes e nas campanhas.</p>
    <% if (c.conta_id && c.temChave) { %><form method="post" action="/painel/configuracoes/whatsapp/oficial/modelos" class="acoes-topo"><button type="submit" class="botao-secundario">Atualizar modelos da Meta</button></form><% } %>
    <div class="tabela-rolagem">
      <table class="tabela">
        <thead><tr><th>Modelo</th><th>Idioma</th><th>Tipo</th><th>Situação</th><th>Texto</th></tr></thead>
        <tbody>
          <% modelos.forEach((m) => { %>
            <tr><td><strong><%= m.nome %></strong></td><td><%= m.idioma %></td><td><%= m.categoria === 'MARKETING' ? 'Marketing' : m.categoria === 'UTILITY' ? 'Utilidade' : m.categoria === 'AUTHENTICATION' ? 'Autenticação' : m.categoria || '—' %></td>
              <td><span class="selo <%= m.situacao === 'APPROVED' ? 'selo-equipe-livre' : 'selo-situacao-ignorado' %>"><%= SITUACAO[m.situacao] || m.situacao %></span></td><td class="texto-modelo"><%= m.corpo %></td></tr>
          <% }) %>
          <% if (!modelos.length) { %><tr><td colspan="5" class="dica">Nenhum modelo ainda.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>
<%- include('../partials/fim-painel') %>
<% if (emUso === 'celular' && numeros.some((n) => n.ativo && !n.estado.conectado)) { %>
<script>
  (function () {
    if (!('EventSource' in window)) return;
    var origem = new EventSource('/painel/eventos');
    origem.addEventListener('whatsapp-status', function () {
      window.location.reload();
    });
  })();
</script>
<% } %>
