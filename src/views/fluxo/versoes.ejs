<%- include('../partials/inicio', { titulo: 'Versões do fluxo' }) %>
<%- include('../partials/nav', { atendenteLogado }) %>
<main class="conteudo pagina-config">
  <p class="trilha-config"><a href="/painel/fluxo?fluxo=<%= fluxoId %>">Fluxo</a> › Versões</p>
  <h1>Versões do fluxo <%= nomeFluxo %></h1>
  <p class="dica">Cada vez que o fluxo é salvo, a versão fica guardada aqui (as últimas 100). Se uma mudança deu errado, clique em
    <strong>Voltar para esta versão</strong>: ela passa a valer na hora para o bot, e o fluxo de agora também fica guardado, então dá para desfazer.</p>
  <% if (restaurada) { %><p class="sucesso">Pronto: o bot já está usando a versão escolhida.</p><% } %>
  <% if (erro) { %><p class="erro"><%= erro %></p><% } %>
  <p class="acoes-topo"><a class="botao-secundario botao" href="/painel/fluxo/exportar?fluxo=<%= fluxoId %>" download>Baixar o fluxo de agora (arquivo)</a></p>

  <div class="tabela-rolagem">
    <table class="tabela">
      <thead><tr><th>Quando</th><th>Quem</th><th>De onde veio</th><th>Blocos</th><th></th></tr></thead>
      <tbody>
        <% versoes.forEach((v) => { %>
          <tr>
            <td class="sem-quebra"><%= v.quando %><% if (v.atual) { %> <span class="selo selo-equipe-livre">em uso</span><% } %></td>
            <td><%= v.quem %></td>
            <td><%= v.origem %></td>
            <td><%= v.blocos %></td>
            <td class="acoes-linha">
              <a href="/painel/fluxo/versoes/<%= v.id %>/baixar" download>Baixar</a>
              <% if (!v.atual) { %>
                <form method="post" action="/painel/fluxo/versoes/<%= v.id %>/restaurar" class="form-inline" onsubmit="return confirm('Voltar o bot para a versão de <%= v.quando %>? Ela passa a valer na hora.')">
                  <button type="submit" class="botao-link">Voltar para esta versão</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
        <% if (!versoes.length) { %><tr><td colspan="5" class="dica">Nenhuma versão ainda.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</main>
<%- include('../partials/fim-painel') %>
