<%- include('partials/inicio', { titulo: 'Configuração inicial' }) %>
<main class="tela-cheia">
  <div class="cartao-login">
    <h1>ChatDigital</h1>
    <p class="subtitulo">Crie o administrador do sistema</p>
    <% if (erro) { %><p class="erro"><%= erro %></p><% } %>
    <form method="post" action="/setup">
      <label>Nome<input type="text" name="nome" required autofocus></label>
      <label>E-mail<input type="email" name="email" required></label>
      <label>Senha<input type="password" name="senha" required minlength="6"></label>
      <button type="submit">Criar administrador</button>
    </form>
  </div>
</main>
<%- include('partials/fim') %>
