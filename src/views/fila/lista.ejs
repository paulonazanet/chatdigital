<%- include('../partials/inicio', { titulo: 'Fila de atendimento' }) %>
<%- include('../partials/nav', { atendenteLogado }) %>
<script src="/js/fila-responder.js" defer></script>
<script src="/js/fila-lista.js" defer></script>
<%
  // Número legível pra mostrar: o de exibição (guardado quando o WhatsApp manda em conversas
  // @lid, que não trazem o número de telefone no endereço) ou, na falta dele, o próprio número
  // sem o sufixo técnico.
  function exibirNumero(c) {
    return c.numero_exibicao || c.numero.replace('@s.whatsapp.net', '').replace('@lid', '');
  }

  // Mostra o texto como o WhatsApp mostra: *negrito*, _itálico_, ~riscado~ (as quebras de linha
  // ficam por conta do white-space no CSS). Escapa o HTML ANTES de formatar — o texto do
  // cliente não pode virar código na tela do atendente.
  function escaparHtml(t) {
    return String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
  // "há 5 min" / "há 2 h" / "há 3 dias" — public/js/fila-lista.js recalcula isso a cada 30s
  // na tela, pra não precisar recarregar a página pra ver o tempo andando.
  function haQuanto(iso) {
    const min = Math.max(0, Math.floor((Date.now() - new Date(iso).getTime()) / 60000));
    if (min < 1) return 'agora';
    if (min < 60) return `há ${min} min`;
    if (min < 1440) return `há ${Math.floor(min / 60)} h`;
    return `há ${Math.floor(min / 1440)} ${min < 2880 ? 'dia' : 'dias'}`;
  }
  function corDaBolinha(iso) {
    const min = (Date.now() - new Date(iso).getTime()) / 60000;
    if (min >= minutosVermelho) return 'vermelha';
    if (min >= minutosAmarelo) return 'amarela';
    return 'verde';
  }
  const ROTULOS_FILTRO = { minhas: 'Minhas', fila: 'Na fila', bot: 'No bot', finalizadas: 'Finalizadas', todas: 'Todas' };
  const setorEscolhido = setorFiltro === 'sem' ? 'Sem setor' : (setores.find((s) => String(s.id) === setorFiltro) || {}).nome;
  // texto que a busca instantânea (public/js/fila-lista.js) compara: dígitos + nome sem acento
  function textoDeBusca(c) {
    const nome = String(c.nome_contato || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    return `${c.numero} ${c.numero_exibicao || ''}`.replace(/\D/g, ' ') + '|' + nome;
  }
  const baseFiltro = conversaSelecionada ? `/painel/fila/${conversaSelecionada.id}` : '/painel/fila';

  function formatarWhatsapp(t) {
    return escaparHtml(t == null ? '' : t)
      .replace(/\*([^*\n]+)\*/g, '<strong>$1</strong>')
      .replace(/(^|[\s(])_([^_\n]+)_(?=[\s).,!?]|$)/gm, '$1<em>$2</em>')
      .replace(/~([^~\n]+)~/g, '<s>$1</s>');
  }
%>
<main class="conteudo-fila" <% if (conversaSelecionada) { %>data-conversa-numero="<%= conversaSelecionada.numero %>"<% } %>>
  <div class="fila-cabecalho">
    <h1>Fila de atendimento</h1>
    <details class="nova-conversa-popover">
      <summary class="botao-como-summary">+ Nova conversa</summary>
      <form method="post" action="/painel/fila/nova" class="form-transferir">
        <label>Número (com DDD e DDI)
          <input type="text" name="numero" placeholder="5581999998888" required>
        </label>
        <label>Mensagem inicial (opcional)
          <textarea name="texto" rows="2" placeholder="Escreva a primeira mensagem..."></textarea>
        </label>
        <button type="submit">Iniciar conversa</button>
      </form>
    </details>
    <% if (erroNovaConversa) { %><p class="erro"><%= erroNovaConversa %></p><% } %>
  </div>

  <div class="fila-corpo">
    <aside class="fila-lista" data-minutos-amarelo="<%= minutosAmarelo %>" data-minutos-vermelho="<%= minutosVermelho %>">
      <div class="fila-filtros">
        <div class="fila-filtros-chips">
          <% Object.entries(ROTULOS_FILTRO).forEach(([chave, rotulo]) => { %>
            <a class="chip-filtro <%= filtro === chave ? 'ativo' : '' %> <%= chave === 'fila' && contagens.fila > 0 && filtro !== 'fila' ? 'chip-alerta' : '' %>" href="<%= baseFiltro %>?filtro=<%= chave %>">
              <%= rotulo %><% if (contagens[chave] !== undefined) { %> <span class="chip-contagem"><%= contagens[chave] %></span><% } %>
            </a>
          <% }) %>
        </div>
        <div class="fila-filtros-busca">
          <form method="get" action="<%= baseFiltro %>" class="busca-cliente" role="search">
            <input type="hidden" name="filtro" value="<%= filtro %>">
            <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="10" r="7"/><path d="M21 21l-6 -6"/></svg>
            <input type="search" name="q" value="<%= busca %>" placeholder="Número ou nome" aria-label="Buscar por número ou nome do cliente" autocomplete="off" <%= busca ? 'autofocus' : '' %>>
          </form>
          <details class="filtro-setor">
            <summary class="<%= setorEscolhido ? 'ativo' : '' %>" title="Filtrar por setor">
              <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v2.2a2 2 0 0 1 -.6 1.4l-4.4 4.4v7l-6 2v-8.5l-4.5 -4.9a2 2 0 0 1 -.5 -1.3z"/></svg>
              <span><%= setorEscolhido || 'Setor' %></span>
              <svg class="icone seta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6l6 -6"/></svg>
            </summary>
            <div class="filtro-setor-menu">
              <a class="<%= !setorFiltro ? 'selecionado' : '' %>" href="<%= baseFiltro %>?filtro=<%= filtro %>&setor=">Todos os setores</a>
              <% setores.forEach((s) => { %>
                <a class="<%= setorFiltro === String(s.id) ? 'selecionado' : '' %>" href="<%= baseFiltro %>?filtro=<%= filtro %>&setor=<%= s.id %>"><%= s.nome %></a>
              <% }) %>
              <a class="<%= setorFiltro === 'sem' ? 'selecionado' : '' %>" href="<%= baseFiltro %>?filtro=<%= filtro %>&setor=sem">Sem setor</a>
            </div>
          </details>
        </div>
      </div>

      <% itens.forEach((c) => { %>
        <div class="item-conversa <%= conversaSelecionada && conversaSelecionada.id === c.id ? 'selecionado' : '' %>" data-busca="<%= textoDeBusca(c) %>">
          <a class="item-link" href="/painel/fila/<%= c.id %>">
            <span class="item-numero"><%= exibirNumero(c) %><% if (c.nome_contato) { %> <span class="item-nome">· <%= c.nome_contato %></span><% } %></span>
            <span class="item-tempo" data-desde="<%= c.desde %>"><%= haQuanto(c.desde) %></span>
            <span class="item-ultima"><%= c.ultima_mensagem_remetente === 'atendente' ? 'Você: ' : c.tipo === 'bot' ? 'Bot: ' : '' %><%= c.ultima_mensagem || '' %></span>
            <span class="item-lado">
              <% if (c.esperandoResposta) { %><span class="bolinha bolinha-<%= corDaBolinha(c.desde) %>" data-desde="<%= c.desde %>" title="Cliente esperando sua resposta"></span><% } %>
              <%= c.tipo === 'bot' ? '' : (c.setor_nome || 'Sem setor') %>
            </span>
          </a>
          <% if (c.tipo === 'bot') { %>
            <form method="post" action="/painel/fila/<%= c.id %>/puxar" class="item-puxar">
              <button type="submit" class="botao-pequeno" title="Tirar do bot e assumir a conversa">Puxar</button>
            </form>
          <% } %>
        </div>
      <% }) %>

      <% if (itens.length === 0) { %>
        <p class="dica fila-vazia"><%= busca ? `Nada encontrado pra "${busca}" aqui.` : {
          minhas: 'Nenhuma conversa com você agora.',
          fila: 'Ninguém esperando um atendente assumir.',
          bot: 'Nenhum cliente parado no meio do fluxo do bot.',
          finalizadas: 'Nenhuma conversa finalizada ainda.',
          todas: 'Nenhuma conversa em andamento.',
        }[filtro] %></p>
      <% } %>
      <p class="dica fila-vazia fila-busca-vazia" hidden>Nada encontrado aqui.</p>
      <% if (filtro === 'finalizadas' && !busca && itens.length >= 50) { %>
        <p class="dica fila-vazia">Mostrando as 50 mais recentes. Use a busca pra achar conversas mais antigas.</p>
      <% } %>
    </aside>

    <section class="fila-detalhe">
      <% if (!conversaSelecionada) { %>
        <div class="fila-detalhe-vazia"><p>Selecione uma conversa na lista ao lado.</p></div>
      <% } else { %>
        <%# fixo no topo: a tela rola sozinha até a última mensagem, e sem isso o número do
            cliente ficava escondido lá em cima numa conversa comprida %>
        <div class="cabecalho-conversa">
          <div class="cabecalho-conversa-info">
            <div class="cabecalho-conversa-titulo">
              <h2><%= exibirNumero(conversaSelecionada) %><% if (conversaSelecionada.nome_contato) { %> <span class="nome-contato">· <%= conversaSelecionada.nome_contato %></span><% } %></h2>
              <details class="renomear-popover">
                <summary class="botao-lapis" title="<%= conversaSelecionada.nome_contato ? 'Trocar o nome do cliente' : 'Dar um nome pro cliente' %>" aria-label="Trocar o nome do cliente">
                  <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4"/><path d="M13.5 6.5l4 4"/></svg>
                </summary>
                <form method="post" action="/painel/fila/<%= conversaSelecionada.id %>/nome" class="form-transferir form-renomear">
                  <label>Nome do cliente
                    <input type="text" name="nome" maxlength="80" value="<%= conversaSelecionada.nome_contato || '' %>" placeholder="Ex.: Maria Silva">
                  </label>
                  <p class="dica">Deixe em branco pra voltar a usar o nome do perfil do WhatsApp.</p>
                  <button type="submit">Salvar nome</button>
                </form>
              </details>
            </div>
            <p class="dica">
              <%= {
                atendendo: `Atendendo: ${conversaSelecionada.atendente_nome || '—'}`,
                aguardando: 'Na fila, esperando alguém assumir',
                bot: 'Com o bot',
                finalizado: 'Finalizada',
              }[conversaSelecionada.status] %> · <%= conversaSelecionada.setor_nome || 'Sem setor' %>
            </p>
          </div>
          <div class="acoes-conversa">
            <% if (conversaSelecionada.status === 'bot') { %>
              <form method="post" action="/painel/fila/<%= conversaSelecionada.id %>/puxar">
                <button type="submit">Puxar pra mim</button>
              </form>
            <% } else if (conversaSelecionada.status !== 'finalizado') { %>
              <% if (conversaSelecionada.status === 'aguardando') { %>
                <form method="post" action="/painel/fila/<%= conversaSelecionada.id %>/assumir">
                  <button type="submit">Assumir conversa</button>
                </form>
              <% } %>
              <details class="transferir-popover">
                <summary class="botao-secundario botao-como-summary">Transferir</summary>
                <form method="post" action="/painel/fila/<%= conversaSelecionada.id %>/transferir" class="form-transferir">
                  <label>Setor
                    <select name="setor_id" required>
                      <option value="">Escolha um setor</option>
                      <% setores.forEach((s) => { %>
                        <option value="<%= s.id %>" <%= conversaSelecionada.setor_id === s.id ? 'selected' : '' %>><%= s.nome %></option>
                      <% }) %>
                    </select>
                  </label>
                  <label>Atendente específico (opcional)
                    <select name="atendente_id">
                      <option value="">Deixar na fila do setor</option>
                      <% atendentes.forEach((a) => { %>
                        <option value="<%= a.id %>"><%= a.nome %></option>
                      <% }) %>
                    </select>
                  </label>
                  <button type="submit">Confirmar transferência</button>
                </form>
              </details>
              <form method="post" action="/painel/fila/<%= conversaSelecionada.id %>/finalizar">
                <button type="submit" class="botao-secundario">Finalizar</button>
              </form>
            <% } %>
          </div>
        </div>

        <div class="historico">
          <% mensagens.forEach((m) => { %>
            <div class="mensagem mensagem-<%= m.remetente %>">
              <span class="mensagem-remetente"><%= m.remetente === 'atendente' && m.atendente_nome ? m.atendente_nome : m.remetente %></span>
              <% if (m.midia_tipo === 'imagem') { %>
                <a href="<%= m.midia_url %>" target="_blank" rel="noopener"><img class="mensagem-midia" src="<%= m.midia_url %>" alt="Imagem enviada"></a>
              <% } else if (m.midia_tipo === 'video') { %>
                <video class="mensagem-midia" src="<%= m.midia_url %>" controls></video>
              <% } else if (m.midia_tipo === 'audio') { %>
                <audio class="mensagem-midia" src="<%= m.midia_url %>" controls></audio>
              <% } else if (m.midia_url) { %>
                <a class="mensagem-arquivo" href="<%= m.midia_url %>" target="_blank" rel="noopener">📄 Baixar arquivo</a>
              <% } %>
              <p><%- formatarWhatsapp(m.texto) %></p>
            </div>
          <% }) %>
          <% if (mensagens.length === 0) { %><p class="dica">Nenhuma mensagem ainda.</p><% } %>
        </div>

        <% if (erro) { %><p class="erro"><%= erro %></p><% } %>

        <% if (conversaSelecionada.status === 'bot') { %>
          <p class="aviso">Essa conversa ainda está com o bot. Use <strong>Puxar pra mim</strong> no topo pra assumir.</p>
        <% } else if (conversaSelecionada.status !== 'finalizado') { %>
          <% if (conversaSelecionada.status === 'atendendo') { %>
            <form method="post" action="/painel/fila/<%= conversaSelecionada.id %>/responder" class="form-responder" enctype="multipart/form-data">
              <div class="form-responder-barra">
                <button type="button" class="botao-emoji" title="Inserir emoji"><svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9 10h.01"/><path d="M15 10h.01"/><path d="M9.5 15a3.5 3.5 0 0 0 5 0"/></svg></button>
                <label class="botao-anexo" title="Anexar imagem, vídeo, áudio ou PDF">
                  <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 7l-6.5 6.5a1.5 1.5 0 0 0 3 3l6.5 -6.5a3 3 0 0 0 -6 -6l-6.5 6.5a4.5 4.5 0 0 0 9 9l6.5 -6.5"/></svg>
                  <input type="file" name="midia" accept="image/*,video/*,audio/*,application/pdf" hidden>
                </label>
                <button type="button" class="botao-gravar-audio" title="Gravar áudio"><svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5a3 3 0 0 1 6 0v5a3 3 0 0 1 -6 0z"/><path d="M5 10a7 7 0 0 0 14 0"/><path d="M8 21h8"/><path d="M12 17v4"/></svg></button>
                <span class="anexo-nome"></span>
                <button type="button" class="botao-remover-anexo" hidden title="Remover">✕</button>
                <div class="emoji-painel" hidden></div>
              </div>
              <div class="form-responder-linha">
                <textarea name="texto" placeholder="Escreva a resposta para o cliente..."></textarea>
                <button type="submit">Enviar</button>
              </div>
            </form>
          <% } else { %>
            <p class="aviso">Assuma a conversa para poder responder direto por aqui.</p>
          <% } %>
        <% } %>
      <% } %>
    </section>
  </div>
</main>
<% if (conversaSelecionada) { %>
  <script>
    // Sempre abre (ou recarrega) já mostrando a mensagem mais recente, sem precisar descer a mão.
    (function () {
      var area = document.querySelector('.fila-detalhe .historico');
      if (area) area.scrollTop = area.scrollHeight;
    })();
  </script>
<% } %>
<%- include('../partials/fim-painel') %>
