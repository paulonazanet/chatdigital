<%- include('../partials/inicio', { titulo: 'Conversa' }) %>
<%- include('../partials/nav', { atendenteLogado }) %>
<main class="conteudo" data-conversa-numero="<%= conversa.numero %>">
  <p><a href="/painel/fila">&larr; Voltar para a fila</a></p>
  <h1><%= conversa.numero.replace('@s.whatsapp.net', '') %></h1>
  <p class="dica">
    Setor: <%= conversa.setor_nome || '—' %> ·
    Status: <%= conversa.status %> ·
    Atendente: <%= conversa.atendente_nome || '—' %>
  </p>

  <div class="historico">
    <% mensagens.forEach((m) => { %>
      <div class="mensagem mensagem-<%= m.remetente %>">
        <span class="mensagem-remetente"><%= m.remetente %></span>
        <p><%= m.texto %></p>
      </div>
    <% }) %>
    <% if (mensagens.length === 0) { %><p class="dica">Nenhuma mensagem ainda.</p><% } %>
  </div>

  <% if (conversa.status !== 'finalizado') { %>
    <div class="acoes-conversa">
      <% if (conversa.status === 'aguardando') { %>
        <form method="post" action="/painel/fila/<%= conversa.id %>/assumir">
          <button type="submit">Assumir conversa</button>
        </form>
      <% } %>
      <form method="post" action="/painel/fila/<%= conversa.id %>/finalizar">
        <button type="submit" class="botao-secundario">Finalizar</button>
      </form>
    </div>

    <% if (erro) { %><p class="erro"><%= erro %></p><% } %>

    <% if (conversa.status === 'atendendo') { %>
      <form method="post" action="/painel/fila/<%= conversa.id %>/responder" class="form-responder">
        <textarea name="texto" placeholder="Escreva a resposta para o cliente..." required></textarea>
        <button type="submit">Enviar</button>
      </form>
    <% } else { %>
      <p class="aviso">Assuma a conversa para poder responder direto por aqui.</p>
    <% } %>
  <% } %>
</main>
<%- include('../partials/fim-painel') %>
