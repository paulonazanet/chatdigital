PORTA=3000
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Número que aparece quando o bot avisa o cliente que vai chamar um atendente humano
NUMERO_ATENDENTE=

# Modo de teste: números separados por vírgula (com DDI, ex.: 5511999998888) que o bot deve
# responder de verdade. Preenchendo isso, todo mundo que não estiver na lista é ignorado pelo bot
# (a mensagem chega no celular normalmente, só não recebe o menu automático) — útil pra testar
# no seu número principal sem o fluxo aparecer pra quem não devia. Deixe em branco em produção.
NUMEROS_TESTE=

